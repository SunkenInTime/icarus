<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <Target Name="RequireParserSource" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(CueRoot)' == ''" Text="Set CueRoot to CUE4Parse source at commit 91e1da69d3341f5777f2307bd712498b6bdc05dc." />
  </Target>
  <ItemGroup>
    <ProjectReference Include="$(CueRoot)/CUE4Parse-Conversion/CUE4Parse-Conversion.csproj" />
  </ItemGroup>
</Project>
