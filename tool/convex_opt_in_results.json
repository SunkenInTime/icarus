{
  "about": "Result values the server sends only to clients that ask for them, so builds that don't know them never receive them. tool/check_convex_shipped_clients.mjs reads this list. \"path\" is a result path as the check prints it; \"sentOnlyWith\" lists the optional argument paths that make the server send it.",
  "optIns": [
    {
      "function": "strategy:getFullSnapshot",
      "path": "result.contentVersion",
      "sentOnlyWith": ["args.includeContentVersion"]
    },
    {
      "function": "ops:applyBatch",
      "path": "result.results[]<status=noop>.wasApplied",
      "sentOnlyWith": ["args.includeWasApplied"]
    },
    {
      "function": "ops:applyBatch",
      "path": "result.serverTime",
      "sentOnlyWith": ["args.sendsLiveBasis"]
    },
    {
      "function": "ops:applyBatch",
      "path": "result.results[]<status=applied>.appliedLife",
      "sentOnlyWith": ["args.sendsLives"]
    },
    {
      "function": "ops:applyBatch",
      "path": "result.results[]<status=noop>.currentLife",
      "sentOnlyWith": ["args.sendsLives"]
    },
    {
      "function": "ops:applyBatch",
      "path": "result.results[]<status=rejected>.current<type=strategy>.life",
      "sentOnlyWith": ["args.sendsLives"]
    },
    {
      "function": "ops:applyBatch",
      "path": "result.results[]<status=rejected>.current<type=page>.life",
      "sentOnlyWith": ["args.sendsLives"]
    },
    {
      "function": "ops:applyBatch",
      "path": "result.results[]<status=rejected>.current<type=pageContent>.life",
      "sentOnlyWith": ["args.sendsLives"]
    },
    {
      "function": "ops:applyBatch",
      "path": "result.results[]<status=rejected>.current<type=element>.life",
      "sentOnlyWith": ["args.sendsLives"]
    },
    {
      "function": "ops:applyBatch",
      "path": "result.results[]<status=rejected>.current<type=lineup>.life",
      "sentOnlyWith": ["args.sendsLives"]
    },
    {
      "function": "ops:applyBatch",
      "path": "result.results[]<status=rejected>.reason",
      "sentOnlyWith": ["args.sendsLives"]
    }
  ]
}
