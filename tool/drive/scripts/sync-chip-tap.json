[
  {"wait": 10},
  {"tapIcon": "x", "optional": true},
  {"signIn": true},
  {"wait": 4},
  {"newCloud": "Chip tap {run}"},
  {"wait": 4},
  {"tapText": "Chip tap {run}"},
  {"wait": 8},
  {"tapIcon": "x", "optional": true},
  {"addAgent": "a{run}", "at": [700, 500]},
  {"waitSettled": 60},
  {"wait": 3},
  {"probe": "synced-before-tap"},
  {"signal": "ready"},
  {"wait": 2},

  {"tapKey": "cloud-sync-button-synced"},
  {"probe": "synced-tapped"},
  {"shot": "{out}/synced-tapped.png"},
  {"waitText": "Saved", "seconds": 3},
  {"shot": "{out}/synced-toast.png"},
  {"waitSettled": 90},
  {"probe": "synced-settled"},
  {"shot": "{out}/synced-settled.png"},
  {"wait": 4},

  {"signal": "go-offline"},
  {"waitFile": "{out}/offline", "seconds": 60},
  {"wait": 5},
  {"probe": "offline-before-tap"},
  {"tapKey": "cloud-sync-button-offline"},
  {"waitText": "Offline, changes stay on this device", "seconds": 3},
  {"probe": "offline-tapped"},
  {"shot": "{out}/offline-tapped.png"},
  {"wait": 4},

  {"addAgent": "c{run}", "at": [900, 500]},
  {"wait": 2},
  {"tapKey": "cloud-sync-button-offline"},
  {"waitText": "Offline · 1 change saved on this computer", "seconds": 3},
  {"probe": "offline-queued-tapped"},
  {"shot": "{out}/offline-queued-tapped.png"},
  {"wait": 4},

  {"signal": "go-online"},
  {"waitFile": "{out}/online", "seconds": 60},
  {"waitSettled": 60},
  {"probe": "online-settled"},
  {"wait": 3},

  {"signal": "go-slow"},
  {"waitFile": "{out}/slow", "seconds": 60},
  {"dragAgent": "a{run}", "by": [60, 40]},
  {"wait": 1},
  {"probe": "in-flight-before-tap"},
  {"tapKey": "cloud-sync-button-syncing"},
  {"probe": "in-flight-tapped"},
  {"shot": "{out}/in-flight-tapped.png"},
  {"waitText": "Saved on this device. Syncing…", "seconds": 3},
  {"waitSettled": 60},
  {"probe": "in-flight-settled"},
  {"waitText": "Saved", "gone": true, "seconds": 10},
  {"exit": 1}
]
