[
  {"wait": 10},
  {"tapIcon": "x", "optional": true},
  {"signIn": true},
  {"storeMayLag": "o1-{run}", "why": "the other person's field edit reaches this store only when its queue asks for o1"},
  {"storeMayLag": "o3-{run}", "why": "the other person's warm-up move of o3 reaches this store only when its queue asks for it"},
  {"wait": 4},
  {"newCloudFolder": "Folder {run}"},
  {"openCloudFolder": "Folder {run}"},
  {"wait": 3},
  {"newCloud": "Fields {run}", "map": "bind"},
  {"wait": 4},
  {"tapText": "Fields {run}"},
  {"wait": 12},
  {"tapIcon": "x", "optional": true},
  {"waitSettled": 60},
  {"storeExpect": true},
  {"storeAdd": "o1-{run}", "kind": "agent", "at": [600, 400]},
  {"storeAdd": "o2-{run}", "kind": "agent", "at": [720, 400]},
  {"storeAdd": "o3-{run}", "kind": "agent", "at": [840, 400]},
  {"waitStoreSent": 60, "landed": "may wait"},
  {"shareLink": "editor", "file": "{out}/edit-code.txt"},
