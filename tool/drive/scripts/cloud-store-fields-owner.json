  {"waitSignal": "mate-in", "seconds": 300},
  {"waitSignal": "mate-warm", "seconds": 120},
  {"storeMove": "o2-{run}", "by": [5, 5], "merge": true},
  {"waitStoreSent": 60, "landed": "may wait"},
  {"signal": "go"},
  {"storeMove": "o1-{run}", "by": [30, 0], "merge": true},
  {"waitStoreSent": 120, "landed": "may wait"},
  {"storeSyncState": true},
  {"signal": "owner-done"},
  {"waitSignal": "mate-done", "seconds": 300},
  {"wait": 3},
