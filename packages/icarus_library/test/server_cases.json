      {
        "send": [
          {
            "opId": "add",
            "type": "element.add",
            "elementPublicId": "e1",
            "pagePublicId": "p",
            "payload": {
              "kind": "agent",
              "payloadVersion": 1,
              "data": {
                "id": "e1",
                "type": "jett"
              }
            },
            "sortIndex": 0
          }
        ],
        "expect": [
          {
            "opId": "add",
            "status": "applied",
            "appliedRevision": 1,
            "appliedLife": "L0"
          }
        ]
      },
      {
        "send": [
          {
            "opId": "first",
            "type": "element.patch",
            "elementPublicId": "e1",
            "payload": {
              "kind": "agent",
              "payloadVersion": 1,
              "data": {
                "id": "e1",
                "type": "jett",
                "position": {
                  "dx": 40,
                  "dy": 0
                }
              }
            },
            "sortIndex": 0,
            "expectedElementRevision": 1,
            "expectedLife": "L0"
          }
        ],
        "expect": [
          {
            "opId": "first",
