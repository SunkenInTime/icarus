  {
    "name": "a batch naming the strategy life it was made in is refused whole once the strategy is made again, and a batch naming the new life applies",
    "steps": [
      {
        "create": true
      },
      {
        "send": [
          {
            "opId": "first",
            "type": "strategy.patch",
            "payload": {
              "name": "First"
            },
            "expectedStrategyRevision": 0
          }
        ],
        "expect": [
          {
            "opId": "first",
            "status": "applied",
            "appliedRevision": 1,
            "appliedLife": "L0"
          }
        ]
      },
      {
        "recreate": true
      },
      {
        "send": [
          {
            "opId": "old",
            "type": "strategy.patch",
            "payload": {
              "name": "Old"
            },
            "expectedStrategyRevision": 1,
            "expectedLife": "L0"
          }
        ],
        "strategyLife": "L0",
        "refused": "STRATEGY_REPLACED",
        "currentLife": "L1"
      },
      {
        "send": [
          {
            "opId": "look",
            "type": "strategy.patch",
            "payload": {
              "name": "Look"
            },
            "expectedStrategyRevision": 1,
            "expectedLife": "L0"
          }
        ],
        "expect": [
          {
            "current": {
              "type": "strategy",
              "revision": 0,
              "life": "L1",
              "value": {
                "mapData": "ascent",
                "name": "Case",
                "themeOverridePalette": null,
                "themeProfileId": null
              }
            },
            "opId": "look",
            "reason": "row_replaced",
            "status": "rejected"
          }
        ]
      },
      {
        "send": [
          {
            "opId": "new",
            "type": "strategy.patch",
            "payload": {
              "name": "New"
            },
            "expectedStrategyRevision": 0,
            "expectedLife": "L1"
          }
        ],
        "strategyLife": "L1",
        "expect": [
          {
            "opId": "new",
            "status": "applied",
            "appliedRevision": 1,
            "appliedLife": "L1"
          }
        ]
      }
    ]
  }
]
